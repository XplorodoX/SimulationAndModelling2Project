		this.consumptionInThisStep = consumptionInThisStep;
    }
    
    public DataMessageFromPC(Agent sender, double consumptionInThisStep) 
    {
    	super(sender, sender.time());
		this.consumptionInThisStep = consumptionInThisStep;
    }

	@Override
	public String toString() 
	{
