						<Action><![CDATA[handler.sendMessagesToAll();


get_Main().plotForPrices.updateData();
get_Main().plotForBattery.updateData();
get_Main().plotForPV.updateData();
get_Main().plotForPC.updateData();
if (get_Main().heatPumpActivated)
	get_Main().plotForHP.updateData();

// mean += (new_value - mean) / count:
get_Main().averageEnergyCost_Euro += (handler.priceInThisStep - get_Main().averageEnergyCost_Euro) / ++averageEnergyCostCount;
get_Main().cumulatedPV += handler.productionInThisStepPV;
get_Main().cumulatedPC += handler.consumptionInThisStepPC;
if (get_Main().heatPumpActivated)
	get_Main().cumulatedHP += handler.consumptionInThisStepHP;]]></Action>
