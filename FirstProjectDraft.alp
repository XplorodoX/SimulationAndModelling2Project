			<Name><![CDATA[DataMessageFromPCForecast]]></Name>
			<Text><![CDATA[public class DataMessageFromPCForecast extends MessageType {
    public final double[] forecast;
    public final double timestampStart;
    public final double timestampEnd;

    public DataMessageFromPCForecast(Agent sender, double timestampStart, double timestampEnd, double[] forecast) {
    	super(sender, timestampStart, timestampEnd);
        this.timestampStart = timestampStart;
        this.timestampEnd = timestampEnd;
        this.forecast = forecast;
    }
}]]></Text>
