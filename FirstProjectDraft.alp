			<Text><![CDATA[/**
 * DataMessageFromPC
 */	
public class DataMessageFromPC extends firstprojectdraft.MessageType implements Serializable 
{

	double consumptionInThisStep;

    /**
     * Constructor initializing the fields
     */
    public DataMessageFromPC(Agent sender, double timestamp, double consumptionInThisStep) 
    {
