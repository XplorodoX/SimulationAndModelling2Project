		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1752504817896</Id>
			<Name><![CDATA[Optimizer]]></Name>
			<Text><![CDATA[import com.gurobi.gurobi.*;

public class Optimizer {

    // fixed parameters
    private final double f;  // round trip efficency
    private final double g;  // max charge / discharge in 15 minutes
    private final double d;  // degredation
    private final double k;  // max battery capacity

    // ––– justierbare technische Konstanten –––
    private double M       = 1e6;   // Big M for nonlinearity
    private double epsilon = 1e-6;  // epsilon for nonlinearity
    private double xmin    = -10.0;   // lower bound on x
    private double xmax    = 10.0;   // upper bound on x

    public Optimizer(double f, double g, double d, double k) {
        if (f <= 0 || f > 1) throw new IllegalArgumentException("f must be in (0,1]");
        if (d < 0 || d > 1) throw new IllegalArgumentException("d must be in [0,1]");
        if (k < 0) throw new IllegalArgumentException("k must be >= 0");
        this.f = 1/f;
        this.g = g;
        this.d = d;
        this.k = k;
    }

    // setters
    public void setBounds(double xmin, double xmax){this.xmin = xmin; this.xmax = xmax;}
    public void setBigM(double M){this.M = M;}
    public void setEpsilon(double eps){this.epsilon = eps;}

    /**
     * Solve MILP for optimal x
     * c: cost vector / energy prices
     * p: powerbalance
     * b: starting battery capacity
     * s: starting state of charge
     */
    public double[] optimize(double[] c, double[] p, double b, double s) throws GRBException {
        int n = p.length;                     // timesteps (one day should have 96)
        if (c.length != n)
            throw new IllegalArgumentException("c und p müssen gleich lang sein (t+1 Werte)");

        GRBEnv env = new GRBEnv(false);
        GRBModel model = new GRBModel(env);
        model.set(GRB.StringAttr.ModelName, "SimMod2_Optimization");

        GRBVar[] x = new GRBVar[n];            // buying / selling
        GRBVar[] delta = new GRBVar[n];            // binary variable δ_i (for nonlinearity)
        GRBVar[] z = new GRBVar[n];            // linearisation z_i = δ_i * x_i

        for (int i = 0; i < n; i++) {
            x[i] = model.addVar(xmin, xmax, 0, GRB.CONTINUOUS, "x_"+i);
            delta[i] = model.addVar(0, 1,       0, GRB.BINARY,     "delta_"+i);
            z[i] = model.addVar(-GRB.INFINITY, GRB.INFINITY, 0, GRB.CONTINUOUS, "z_"+i);
        }

        // Big M constraints
        for (int i = 0; i < n; i++) {
            // x_i + p_i ≤ M (1 - δ_i)
            GRBLinExpr lhs1 = new GRBLinExpr(); lhs1.addTerm(1, x[i]); lhs1.addConstant(p[i]);
            GRBLinExpr rhs1 = new GRBLinExpr(); rhs1.addConstant(M); rhs1.addTerm(-M, delta[i]);
            model.addConstr(lhs1, GRB.LESS_EQUAL, rhs1, "bigM1_"+i);

            // x_i + p_i ≥ ε - M δ_i
            GRBLinExpr lhs2 = new GRBLinExpr(); lhs2.addTerm(1, x[i]); lhs2.addConstant(p[i]);
            GRBLinExpr rhs2 = new GRBLinExpr(); rhs2.addConstant(epsilon); rhs2.addTerm(-M, delta[i]);
            model.addConstr(lhs2, GRB.GREATER_EQUAL, rhs2, "bigM2_"+i);
        }

        // Linearisation z_i = δ_i * x_i
        for (int i = 0; i < n; i++) {
            // z_i ≤ x_i − xmin (1 − δ_i)
            GRBLinExpr c3 = new GRBLinExpr(); c3.addTerm(1, x[i]); c3.addConstant(-xmin); c3.addTerm(xmin, delta[i]);
            model.addConstr(z[i], GRB.LESS_EQUAL, c3, "lin3a_"+i);

            // z_i ≥ x_i − xmax (1 − δ_i)
            GRBLinExpr c4 = new GRBLinExpr(); c4.addTerm(1, x[i]); c4.addConstant(-xmax); c4.addTerm(xmax, delta[i]);
            model.addConstr(z[i], GRB.GREATER_EQUAL, c4, "lin3b_"+i);

            // z_i ≤ xmax · δ_i
            GRBLinExpr c5 = new GRBLinExpr(); c5.addTerm(xmax, delta[i]);
            model.addConstr(z[i], GRB.LESS_EQUAL, c5, "lin3c_"+i);

            // z_i ≥ xmin · δ_i
            GRBLinExpr c6 = new GRBLinExpr(); c6.addTerm(xmin, delta[i]);
            model.addConstr(z[i], GRB.GREATER_EQUAL, c6, "lin3d_"+i);
        }

        // State of Charge (summed over timesteps)
        double scale = 1 + d / k;

        GRBLinExpr cumulative = new GRBLinExpr();

        for (int i = 0; i < n; i++) {
            GRBLinExpr term = new GRBLinExpr();
            term.addTerm(1.0 / f, x[i]);
            term.addTerm(f - 1.0 / f, z[i]);
            term.addTerm((f - 1.0 / f) * p[i], delta[i]);
            term.addConstant(p[i] / f);

            cumulative.multAdd(scale, term);  // cumulative += scale * term

            // Now add constraint: 0 ≤ cumulative ≤ b - s
            model.addConstr(cumulative, GRB.GREATER_EQUAL, -s, "eq7_lower_" + i);
            model.addConstr(cumulative, GRB.LESS_EQUAL, b - s, "eq7_upper_" + i);
        }

        // Max Charge / Discharge
        for (int i = 0; i < n; i++) {
            GRBLinExpr expr = new GRBLinExpr();
            expr.addTerm(1.0 / f, x[i]);                    // (1/f) * x_i
            expr.addTerm(f - 1.0 / f, z[i]);                // (f - 1/f) * z_i
            expr.addTerm((f - 1.0 / f) * p[i], delta[i]);   // (f - 1/f) * p_i * δ_i
            expr.addConstant(p[i] / f);                     // (1/f) * p_i

            // -g ≤ expr ≤ g
            GRBLinExpr plusG  = new GRBLinExpr(); plusG.addConstant(g);
            GRBLinExpr minusG = new GRBLinExpr(); minusG.addConstant(-g);
            model.addConstr(expr, GRB.LESS_EQUAL, plusG,  "gUpper_"+i);
            model.addConstr(expr, GRB.GREATER_EQUAL, minusG, "gLower_"+i);
        }

        // cost function min c^T x
        GRBLinExpr obj = new GRBLinExpr();
        for (int i = 0; i < n; i++) obj.addTerm(c[i], x[i]);
        model.setObjective(obj, GRB.MINIMIZE);

        model.optimize();

        double[] xOpt = new double[n];
        for (int i = 0; i < n; i++) xOpt[i] = x[i].get(GRB.DoubleAttr.X);

        model.dispose(); env.dispose();
        return xOpt;
    }
    
    public double[] solve(double[] c, double[] p, double b, double s){
    	try {
            return optimize(c, p, b, s);
        } catch (GRBException e) {
            e.printStackTrace();
            return null; // oder: throw new RuntimeException(e);
        }
    }
}
]]></Text>
		</JavaClass>
