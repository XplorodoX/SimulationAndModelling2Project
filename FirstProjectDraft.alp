		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1749855173213</Id>
			<Name><![CDATA[PCJava]]></Name>
			<Text><![CDATA[import java.io.Serializable;
import java.time.*;

public class PCJava implements Serializable {

    private static final long serialVersionUID = 1L;

    private PC owner;
    private int numPeople;
    private static final String TABLE_NAME = "household_data";
    private static final String TIME_COLUMN = "utc_timestamp";
    private static final String DATA_COLUMN = "average_per_person_consumption";

    public PCJava(PC owner, int numPeople) {
        this.owner = owner;
        this.numPeople = numPeople;
        DBRequest.initializeConnectionPool(); // Ensure connection is available
    }

    public void messageIn(MessageType msg) {
        if (msg instanceof DataResponceTriggerMessageForForecast forecastMsg) {
            double start = forecastMsg.timestampStart;
            double end = forecastMsg.timestampEnd;

            double[] forecast = getForecastUsingHistoricalData(start, end, numPeople);
            owner.port.send(new DataMessageFromPCForecast(owner, start, end, forecast));
        }

        // Optional: If needed, handle current consumption:
        else if (msg instanceof DataResponseTriggerMessage) {
            LocalDateTime now = DateTimeConversionJava.getTimeNow(owner);
            LocalDateTime mapped = convertTo2016Equivalent(now);
            double avgPerPerson = DBRequest.getValueAtTime(TABLE_NAME, TIME_COLUMN, DATA_COLUMN, mapped);
            double value = avgPerPerson * numPeople;

            owner.port.send(new DataMessageFromPC(owner, value));
        }
    }

    // Forecast future consumption using mapped historical data (e.g. Jan 5 2048 → Jan 5 2016)
    public double[] getForecastUsingHistoricalData(double start, double end, int numberOfPeople) {
        int steps = (int) ((end - start) / 900) + 1;  // 900 seconds = 15 min
        double[] result = new double[steps];

        for (int i = 0; i < steps; i++) {
            double simTime = start + i * 900.0;
            LocalDateTime actualTime = DateTimeConversionJava.doubleToCurrentLocalDateTime(simTime);
            LocalDateTime mappedTime = convertTo2016Equivalent(actualTime);

            double avgPerPerson = DBRequest.getValueAtTime(TABLE_NAME, TIME_COLUMN, DATA_COLUMN, mappedTime);
            result[i] = avgPerPerson * numberOfPeople;
        }

        return result;
    }

    // If year is not 2016, map date to the same MM-DD hh:mm in 2016.
    private LocalDateTime convertTo2016Equivalent(LocalDateTime time) {
        int day = Math.min(
            time.getDayOfMonth(),
            Year.of(2016).atMonth(time.getMonth()).lengthOfMonth()
        );
        return LocalDateTime.of(2016, time.getMonth(), day, time.getHour(), time.getMinute());
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1749855182460</Id>
			<Name><![CDATA[PVJava]]></Name>
			<Text><![CDATA[/**
 * PVHandler
 */

import java.time.*;
import java.io.Serializable;

public class PVJava implements Serializable
{
    // Korrigierte Spaltennamen für die PV-Tabelle
    String table_name = "pv";
    String timestamp_column = "Time";
    String data_column = "kWh";
    
    //The kWp our csv source uses
    double data_kWp = 1;

    public void messageIn(MessageType msg)
    {
        if (msg instanceof DataResponseTriggerMessage)
        {
            owner.port.send(new DataMessageFromPV(owner, owner.time(), calculateCurrentProduction(owner.time())));
            //System.out.println(calculateCurrentProduction());
        }
        else if (msg instanceof DataResponceTriggerMessageForForecast)
        {
            double start = msg.timestampStart;
            double end = msg.timestampEnd;
            owner.port.send(new DataMessageFromPVForecast(owner, start, end, forecastFutureProduction(start,end)));
        }
    }

    private final double module_kWp;
    private final int module_count;
    public PV owner;

    public PVJava(PV owner,
                  double module_kWp,
                  int module_count)
    {
        DBRequest.initializeConnectionPool();
        LocalDateTime simStart = LocalDateTime.of(2005, 1, 1, 0, 0);
        LocalDateTime simEnd = LocalDateTime.of(2023, 12, 31, 23, 59);
        
        DBRequest.preloadTimeSeriesData(table_name, timestamp_column, data_column, simStart, simEnd);
       
        this.owner = owner;
        this.module_kWp = module_kWp;

        this.module_count = module_count;
    }

    private double getAgeFactor(double lookUpTime)
    {
        double age = lookUpTime / 31536000;
        double aging_factor = 0.008;
        return Math.pow(1 - aging_factor, age);
    }

    public double calculateCurrentProduction(double lookUpTime)
    {
        double base_kWh = db_communication(lookUpTime);

        double total_kWp = module_count * module_kWp;

        double kWp_Factor = total_kWp / data_kWp;

        return base_kWh * kWp_Factor * getAgeFactor(lookUpTime);
    }
    
    public double[] forecastFutureProduction(double start, double end )
    {
    	int steps = (int) ((end - start) / 900) + 1;
    	double[] result = new double[steps];
    	
        for(int x = 0; x < steps; x++)
        {
        	double timestamp = start + x * 900.0; 
        	result[x] = calculateCurrentProduction(timestamp);
        }
        
    	return result;  
    }

    public double db_communication(double loopUpTime)
    {

        LocalDateTime time = DateTimeConversionJava.doubleToCurrentLocalDateTime(loopUpTime);

        double raw_kWh = DBRequest.getValueAtTime(table_name, timestamp_column, data_column, time);

        return raw_kWh;
    }
    
    //TODO Change location?
    public double calculateTotalPVcost(int kWpInstalled)
    {
    	//Estimated costs: 1500 inverter + 3000 installation + 900 per installed kWp
    	return 1500 + 3000 + 900 * kWpInstalled;
    }

    @Override
    public String toString() {
        return super.toString();
    }

    /**
     * This number is here for model snapshot storing purpose<br>
     * It needs to be changed when this class gets changed
     */
    private static final long serialVersionUID = 1L;
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1749897517471</Id>
			<Name><![CDATA[BatteryJava]]></Name>
			<Text><![CDATA[/**
 * BatteryHandler
 */	
public class BatteryJava implements Serializable 
{

	// --- Batteryparameter ---
	private Battery owner;
	public double capacity;            // Capacity [kWh]
	public double maxCapacity;         // maxCapacity [kWh]
	public double stateOfCharge;       // Current charge [kWh]
    private double maxChargePower;      // Maximum charge in one timestep [kWh]
    private double maxDischargePower;   // Maximum discharge in one timestep [kWh]
    private double roundTripEfficiency; // Charge-Discharge efficiency (applied twice)
    private double degradationPerCycle; // Capacity loss per cycle [%/1.0]

    private double cycles;              // Charging cycles

    public BatteryJava(Battery owner, double capacity, double maxChargePower, double maxDischargePower, double roundTripEfficiency, double degradationPerCycle) 
    {
    	this.owner = owner;
        this.capacity = capacity;
        this.maxCapacity = capacity;
        this.stateOfCharge = 0.0;
        this.maxChargePower = maxChargePower;
        this.maxDischargePower = maxDischargePower;
        this.roundTripEfficiency = roundTripEfficiency;
        this.degradationPerCycle = degradationPerCycle;
        this.cycles = 0;
    }

    // Charges battery and returns overflow
    public double charge(double requestedEnergy) 
    {
        double maxPossibleCharge = Math.min(maxChargePower, (capacity - stateOfCharge));
        double reducedEnergy = requestedEnergy * roundTripEfficiency;
        double actualCharge = Math.min(reducedEnergy, maxPossibleCharge);
        double overflow = (reducedEnergy - actualCharge) / roundTripEfficiency; // For usage in Anylogic

        stateOfCharge += actualCharge;
        if(maxCapacity != 0){
        	cycles += actualCharge / maxCapacity;
        }
        
        //System.out.println("stateOfCharge: " +stateOfCharge);

        applyDegradation();

        return overflow;
    }

    // Discharges battery and returns missing
    // trueDischarge tries to consider roundTripEfficiency beforehand
    public double discharge(double requestedEnergy, boolean trueDischarge) 
    {
        double newRequestedEnergy = Math.abs(requestedEnergy);
        if(trueDischarge) {
            newRequestedEnergy /= roundTripEfficiency;
        }
        double maxPossibleDischarge = Math.min(maxDischargePower, stateOfCharge);
        double actualDischarge = Math.min(newRequestedEnergy, maxPossibleDischarge);

        double missing = (newRequestedEnergy - actualDischarge) * roundTripEfficiency;

        stateOfCharge -= actualDischarge;
        
        if(maxCapacity != 0){
        	cycles += actualDischarge / maxCapacity;
        }
        
        //System.out.println("maxPossibleDischarge: " +maxPossibleDischarge);
        //System.out.println("actualDischarge: " +actualDischarge);
        //System.out.println("stateOfCharge: " +stateOfCharge);
        //System.out.println("maxDischargePower: " +maxDischargePower);
        //System.out.println("requestedEnergy: " +requestedEnergy);
        //System.out.println("missing: " +missing);
        
        applyDegradation();
        
        return missing;
    }

    // Simulate Degradation
    public void applyDegradation() 
    {
        double degradedCapacity = maxCapacity * (1 - degradationPerCycle * cycles);
        capacity = Math.max(degradedCapacity, 0);
        stateOfCharge = Math.min(stateOfCharge, capacity);
    }

    // Getter
    public double getSOC() 
    {
        return stateOfCharge;
    }

    public double getCapacity() 
    {
        return capacity;
    }

    public double getCycles() 
    {
        return cycles;
    }

    public double getSOCPercentage() 
    {
        return (stateOfCharge / capacity) * 100.0;
    }


	@Override
	public String toString() 
	{
		return super.toString();
	}
	
	public void messageIn(MessageType generalMsg) 
	{
		
		
		if (generalMsg instanceof DataMessageToBattery)
		{		
			DataMessageToBattery msg = (DataMessageToBattery)(generalMsg);
			
			double difference;
			double powerBalance = msg.powerBalance;
			if(powerBalance > 0) 
			{
				difference = charge(powerBalance);
			}
			else 
			{
				difference = discharge(powerBalance, true);
			}
			owner.port.send(new DataMessageFromBattery(owner, owner.time(), difference, this.stateOfCharge));
		}
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1750068153877</Id>
			<Name><![CDATA[DataMessageFromBattery]]></Name>
			<Text><![CDATA[/**
 * DataMessageFromBattery
 */	
public class DataMessageFromBattery extends firstprojectdraft.MessageType implements Serializable 
{
	
	public double difference;
	public double stateOfCharge;
    /**
     * Default constructor
     */
    public DataMessageFromBattery(Agent sender, double timestamp, double difference, double stateOfCharge) 
    {    	
    	super(sender, timestamp);
    	this.difference = difference;
    	this.stateOfCharge = stateOfCharge;    	
    }

	@Override
	public String toString() 
	{
		return super.toString();
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1750098928288</Id>
			<Name><![CDATA[DataMessageToBattery]]></Name>
			<Text><![CDATA[/**
 * DataMessageToBattery
 */	
public class DataMessageToBattery extends firstprojectdraft.MessageType implements Serializable {
	double powerBalance;
    /**
     * Default constructor
     */
    public DataMessageToBattery(Agent sender, double timestamp, double powerBalance) {
    	super(sender, timestamp);
    	this.powerBalance = powerBalance;
    }

	@Override
