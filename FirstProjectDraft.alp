		<JavaClass>
			<Id>1751731747057</Id>
			<Name><![CDATA[priceJava]]></Name>
			<Text><![CDATA[/**
 * priceHandler
 */

import java.time.*;
import java.io.Serializable;

public class priceJava implements Serializable
{
    // Korrigierte Spaltennamen für die Price-Tabelle
    String table_name = "price";
    String timestamp_column = "Time";
    String data_column = "price_kWh";

    public void messageIn(MessageType msg)
    {
        if (msg instanceof DataResponseTriggerMessage)
        {
            owner.port.send(new DataMessageFromPrice(owner, owner.time(), getCurrentPrice(owner.time())));
            //System.out.println(getCurrentPrice());
        }
        else if (msg instanceof DataResponceTriggerMessageForForecast)
        {
        	double start = msg.timestampStart;
            double end = msg.timestampEnd;
        	owner.port.send(new DataMessageFromPriceForecast(owner, start, end, forecastFuturePrice(start,end)));
        }
    }
    public price owner;

    public priceJava(price owner)             
    {
        DBRequest.initializeConnectionPool();
        LocalDateTime simStart = LocalDateTime.of(2016, 1, 1, 0, 0);
        LocalDateTime simEnd = LocalDateTime.of(2024, 12, 31, 23, 59);
        
        DBRequest.preloadTimeSeriesData(table_name, timestamp_column, data_column, simStart, simEnd);
       
        this.owner = owner;
    }

    public double getCurrentPrice(double timestamp)
    {
        double base_price = db_communication(timestamp);

        //We use the energy tariff listed at the homepage below
        //https://www.awattar.at/tariffs/hourly
        
        double price = ((base_price * 1.03) + 0.015) * 1.2;
        
        //System.out.printf("Basispreis in Euro / kWh:    %.6f%n", base_price);
        //System.out.printf("Strompreis in Euro / kWh:    %.6f%n", price);

        
        return price;
    }
    
    public double[] forecastFuturePrice(double start, double end )
    {
    	int steps = (int) ((end - start) / 900) + 1;
    	double[] result = new double[steps];
    	
        for(int x = 0; x < steps; x++)
        {
        	double timestamp = start + x * 900.0; 
        	result[x] = getCurrentPrice(timestamp);
        }
        
    	return result;  
    }

    public double db_communication(double timestamp)
    {

        LocalDateTime time = DateTimeConversionJava.doubleToCurrentLocalDateTime(timestamp);

        double base_price = DBRequest.getValueAtTime(table_name, timestamp_column, data_column, time);

        return base_price;
    }

    @Override
    public String toString() {
        return super.toString();
    }

    /**
     * This number is here for model snapshot storing purpose<br>
     * It needs to be changed when this class gets changed
     */
    private static final long serialVersionUID = 1L;
}]]></Text>
		</JavaClass>
