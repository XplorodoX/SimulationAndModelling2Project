		<JavaClass>
			<Id>1751893934902</Id>
			<Name><![CDATA[ParamSetter]]></Name>
			<Text><![CDATA[/**
 * ParamSetter
 */	
import java.util.List;

public class ParamSetter {
    public List<List<String>> rawData;
    public ParamSetter(TextFile csvFile){
    	List<List<String>> csvData = new ArrayList<>();
    	boolean first = true;
    	String line;
    	while((line = csvFile.readLine()) != null){
    		if(first){
    			first = false;
    			continue;
    		}
    		String[] fields = line.split(",");
    		List<String> row = Arrays.asList(fields);
    		csvData.add(row);
    	}
        this.rawData = csvData;
        csvFile.close();
    }
    public List<String> getParams(int paramIndex){
    	return this.rawData.get(paramIndex);
    }
    public BatteryJava initBattery(int paramIndex, Battery owner){
    	List<String> params = getParams(paramIndex);
    	double numBatteries = Double.parseDouble(params.get(22));
    	double capacity = Double.parseDouble(params.get(13));
    	double maxChargePower = Double.parseDouble(params.get(14));
    	double maxDischargePower = Double.parseDouble(params.get(15));
    	double roundTripEfficiency = Double.parseDouble(params.get(16));
    	double degradationPerCycle = Double.parseDouble(params.get(17));
        return new BatteryJava(owner, numBatteries * capacity, maxChargePower, maxDischargePower, roundTripEfficiency, degradationPerCycle);
    }
    public PCJava initPC(int paramIndex, PC owner){
    	List<String> params = getParams(paramIndex);
    	int numberOfPeople = Integer.parseInt(params.get(2));
    	return new PCJava(owner, numberOfPeople);
    }
    public PVJava initPV(int paramIndex, PV owner){
    	List<String> params = getParams(paramIndex);
    	double kWp = Double.parseDouble(params.get(5));
    	int moduleCount = Integer.parseInt(params.get(21));
    	return new PVJava(owner, kWp, moduleCount);
    }
    public HouseControllerJava initHouseController(int paramIndex, HouseController owner){
    	List<String> params = getParams(paramIndex);
    	int strategy = Integer.parseInt(params.get(20));
    	
    	double numBatteries = Double.parseDouble(params.get(22));
    	double capacity = Double.parseDouble(params.get(13));
    	double maxChargePower = Double.parseDouble(params.get(14));
    	double maxDischargePower = Double.parseDouble(params.get(15));
    	double roundTripEfficiency = Double.parseDouble(params.get(16));
    	double degradationPerCycle = Double.parseDouble(params.get(17));
    	
    	return new HouseControllerJava(owner, strategy, roundTripEfficiency, maxChargePower, degradationPerCycle, numBatteries * capacity);
    }
    public boolean heatPumpActivation(int paramIndex){
    	List<String> params = getParams(paramIndex);
    	boolean activation = Boolean.parseBoolean(params.get(18));
    	return activation;
    }
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1752084957323</Id>
			<Name><![CDATA[EVJava]]></Name>
			<Text><![CDATA[/**
 * evHandler
 */

import java.time.*;
import java.io.Serializable;

public class EVJava implements Serializable
{
    public void messageIn(MessageType msg)
    {
        if (msg instanceof DataResponseTriggerMessage)
        {
            //owner.port.send(new DataMessageFromEV(owner, owner.time(), getEnergyUsedToday(owner.time())));
        }
        else if (msg instanceof DataResponceTriggerMessageForForecast)
        {
        	double start = msg.timestampStart;
            double end = msg.timestampEnd;
        	//owner.port.send(new DataMessageFromEVForecast(owner, owner.time(), forecastFutureConsumption(start,end)));
        }
    }
    
    public EV owner;
    private double kmPerYear;
    private double kWhPerKm;

    public EVJava(EV owner, double kmPerYear, double kWhPerKm)             
    {         	
    	this.kmPerYear = kmPerYear;
    	this.kWhPerKm = kWhPerKm;
        this.owner = owner;
    }

    public double getEnergyUsedToday(double timestamp)
    {    	    	
    	double kmDrivenToday = kmPerYear /  365;
    	
    	double energyUsedToday = kmDrivenToday * kWhPerKm;
    	
        return energyUsedToday;
    }
    
    public double[] forecastFutureConsumption(double start, double end )
    {
    	int steps = (int) ((end - start) / 86400) + 1;
    	double[] result = new double[steps];
    	
        for(int x = 0; x < steps; x++)
        {
        	double timestamp = start + x * 86400; 
        	result[x] = getEnergyUsedToday(timestamp);
        }
        
    	return result;  
    }

    @Override
    public String toString() {
        return super.toString();
    }

    /**
     * This number is here for model snapshot storing purpose<br>
     * It needs to be changed when this class gets changed
     */
    private static final long serialVersionUID = 1L;
}]]></Text>
		</JavaClass>
