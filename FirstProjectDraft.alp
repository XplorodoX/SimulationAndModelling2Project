		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1749487208744</Id>
			<Name><![CDATA[HouseControllerJava]]></Name>
			<Text><![CDATA[/**
 * HouseControllerJava
 */	
import java.time.*;
import java.io.Serializable;
import java.util.List;

public class HouseControllerJava implements Serializable 
{
	public HouseController owner;
	public int strategy;
	public double productionInThisStepPV;
	public double consumptionInThisStepPC;
	public double consumptionInThisStepHP;
	public double stateOfChargeInThisStep;
	public double priceInThisStep;
	public double evEnergyUsedToday;
	public double[] forecastPV;
	public double[] forecastPC;
	public double[] forecastPrice;
	public double[] forecastevEnergyUsed;
	public double[] forecastPowerbalance;
	public double[] optimalStrategy;
	public int strategyStepCounter;
	//private double powerBalanceInThisStep;
	private double differenceInThisStep;
	private int messageCounter = 0;
	private int numMessagesPerStep = 4;
	private int numMessagesChange = 3;// +5 Forecasts + EV normal TODO
	private double powerBalanceInThisStep;
	
	private Optimizer optimizer;
	
	private int stepCounter;
	
	//private static final String PRICE_TABLE = "price";
	//private static final String PRICE_TIMESTAMP_COLUMN = "Time";
	//private static final String PRICE_DATA_COLUMN = "price_kWh";   
	
    /**
     * Constructor
     */
    public HouseControllerJava(HouseController owner, int strategy, double f, double g, double d, double k) 
    {
    	this.owner = owner;
    	this.strategy = strategy;
    	this.optimizer = new Optimizer(f, g, d, k);
    	this.stepCounter = 96;
    	
		DBRequest.initializeConnectionPool();
    	
        LocalDateTime simStart = LocalDateTime.of(2016, 1, 1, 0, 0);
        LocalDateTime simEnd = LocalDateTime.of(2016, 12, 31, 23, 59);
        
        //DBRequest.preloadTimeSeriesData(PRICE_TABLE, PRICE_TIMESTAMP_COLUMN, PRICE_DATA_COLUMN, simStart, simEnd);
    }

	@Override
	public String toString() {
		return super.toString();
	}
	
	public boolean sendMessagesToAll() 
	{
		owner.port.send(new DataResponseTriggerMessage(owner, owner.time())); 
		// should only trigger the sending of the data, so it doesnt be a specific message
		
		if(stepCounter == 96) {
		//send to EV
		owner.port.send(new DataResponceTriggerMessageForForecast(owner, owner.time(), owner.time() + 900 * 96));
		}
		return true;
	}	
	
	public void messageIn(MessageType msg) 
	{
		if(stepCounter == 96) {
			numMessagesPerStep += numMessagesChange;
			stepCounter = 0;
		}
		stepCounter++;
		//System.out.println("msg in HouseController: " + msg);
		messageCounter++;
		
		if (msg instanceof DataMessageFromPrice)
		{
			double data = ((DataMessageFromPrice) msg).priceInThisStep;
			this.priceInThisStep = ((DataMessageFromPrice) msg).priceInThisStep;
		}
		
		else if (msg instanceof DataMessageFromPV)
		{
			double data = ((DataMessageFromPV) msg).productionInThisStep;
			
			this.productionInThisStepPV = ((DataMessageFromPV) msg).productionInThisStep;
			//this.powerBalanceInThisStep = this.productionInThisStepPV - this.consumptionInThisStepPC;
			
			//System.out.println("THIS WAS PV");
		}
		else if (msg instanceof DataMessageFromPC)
		{
			double data = ((DataMessageFromPC) msg).consumptionInThisStep;

			//owner.meinDatensatz.add(owner.time(), data);
			
			this.consumptionInThisStepPC = ((DataMessageFromPC) msg).consumptionInThisStep;
			//this.powerBalanceInThisStep = this.productionInThisStepPV - this.consumptionInThisStepPC;
			
			//System.out.println("THIS WAS PC");			
		}
		else if (msg instanceof DataMessageFromHP)
		{
			this.consumptionInThisStepHP = ((DataMessageFromHP) msg).consumptionInThisStep;
		}   
		
		else if (msg instanceof DataMessageFromBattery)
		{			
			differenceInThisStep = ((DataMessageFromBattery) msg).difference;
			stateOfChargeInThisStep = ((DataMessageFromBattery) msg).stateOfCharge;
		}
		
		else if(msg instanceof DataMessageFromPVForecast)
		{
			//System.out.println("Das ist die PV forecast!");
			this.forecastPV = ((DataMessageFromPVForecast) msg).productionForRange;
			
			//for(int x = 0; x < forecastPV.length; x++)
			//{
			//	System.out.println(forecastPV[x]);
			//}
		}
		else if(msg instanceof DataMessageFromPCForecast)
		{
			this.forecastPC = ((DataMessageFromPCForecast) msg).forecast;
		}
		else if (msg instanceof DataMessageFromPriceForecast)
		{
			//System.out.println("Das ist die price forecast!");
			this.forecastPrice = ((DataMessageFromPriceForecast) msg).priceForRange;
			
			//for(int x = 0; x < forecastPrice.length; x++)
			//{
			//	System.out.println(forecastPrice[x]);
			//}
		}
		else if (msg instanceof DataMessageFromEV)
		{
			this.evEnergyUsedToday = ((DataMessageFromEV) msg).energyUsedToday;
		}
		
		else if(msg instanceof DataMessageFromEVForecast)
		{
			this.forecastevEnergyUsed = ((DataMessageFromEVForecast) msg).consumptionForRange;
		}
		
		
		else
		{
		 	System.out.println("ERROR IN \"messageIn\". ");
		}
		
		if (messageCounter < numMessagesPerStep) 
		{
			// still have to get messages from first ones (now PC, PV)
		}
		else if (messageCounter == numMessagesPerStep)
		{
			powerBalanceInThisStep = productionInThisStepPV - consumptionInThisStepPC;
			
			if(stepCounter == 1) {
				this.forecastPowerbalance = calculatePowerbalanceForecast();
				this.optimalStrategy = optimizer.solve(this.forecastPrice, this.forecastPowerbalance, owner.get_Main().battery.handler.capacity, owner.get_Main().battery.handler.stateOfCharge);
			}
			
			if (owner.get_Main().heatPumpActivated)
				powerBalanceInThisStep -= consumptionInThisStepHP;
			if(strategy == 1) {
				// optimal strategy
				followOptimalStrategy();
			}else if(strategy == 2) {
				// heuristic
			}else {
				// greedy
				owner.port.send(new DataMessageToBattery(owner, owner.time(), powerBalanceInThisStep));
			}
		}
		else 
		{
			if(strategy == 1) {
				// optimal strategy
			}else if(strategy == 2) {
				// heuristic
			}else {
				// greedy
				simpleStrat();
			}
			messageCounter = 0;
			if(stepCounter == 1) {
				numMessagesPerStep -= numMessagesChange;
			}
		}		
	}	
	
	public void simpleStrat() 
	{
		// what strat does: 
		// 1) determine what to do
		// 2) buy / sell energy
		// 3) send orders to battery
		
		//System.out.println(differenceInThisStep);
		//System.out.println(powerBalanceInThisStep);
		
		//double currentEnergyCost = 0;
		
        LocalDateTime now = DateTimeConversionJava.getTimeNow(owner);  
        
        //double valueObj = DBRequest.getValueAtTime(PRICE_TABLE, PRICE_TIMESTAMP_COLUMN, PRICE_DATA_COLUMN, now);
        
        //currentEnergyCost = ((Number)valueObj).doubleValue() / 4;
        
		if(powerBalanceInThisStep > 0) 
		{
			owner.energy += differenceInThisStep;
			owner.get_Main().totalEnergySaved += differenceInThisStep;
			owner.moneySaved += differenceInThisStep * priceInThisStep;
		}
		else 
		{
			owner.energy -= differenceInThisStep;
			owner.get_Main().totalEnergySaved -= differenceInThisStep;
			owner.moneySaved -= differenceInThisStep * priceInThisStep;
		}				
	}
	
	public void followOptimalStrategy(){
		double difference = optimalStrategy[strategyStepCounter];
		double chargeChange = difference + powerBalanceInThisStep;
		owner.port.send(new DataMessageToBattery(owner, owner.time(), chargeChange));
		
		owner.energy += difference;
		owner.get_Main().totalEnergySaved += difference;
		owner.moneySaved += difference * priceInThisStep;
		strategyStepCounter ++;
	}
	
	public double[] calculatePowerbalanceForecast() {
		int t = this.forecastPV.length;
		double[] powerbalance = new double[t];
		for(int i = 0; i < t; i++) {
			powerbalance[i] = this.forecastPV[i] - this.forecastPC[i];// Update after Heatpump and EV
		}
		return powerbalance;
	}
	
	public void tstFct1() 
	{
		System.out.println("Do I have access to a parameter in Main from HouseController? => yes");
		
		List<?> items = owner.getConnections();		
		items.forEach(item -> System.out.println(item));
		// => does nothing
	}
	
	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1749737982026</Id>
			<Name><![CDATA[MessageType]]></Name>
			<Text><![CDATA[/**
 * MessageType
 */	
public abstract class MessageType implements Serializable {

	 public Agent sender;
	 //public Agent receiver;
	 
	 public double timestamp;
	 
	 public double timestampStart;
	 public double timestampEnd;

    /**
     * Constructor initializing the fields
     */
    public MessageType(Agent sender, double timestamp) {
		this.sender = sender;
    	//this.receiver = receiver;
		
		this.timestamp = timestamp;
    }
    
    public MessageType(Agent sender, double timestampStart, double timestampEnd) {
		this.sender = sender;
    	//this.receiver = receiver;
		
		this.timestampStart = timestampStart;
		this.timestampEnd = timestampEnd;
    }

	@Override
	public String toString() {
		return  
			"sender = " + sender +" " +
			"timestamp = " + timestamp +" ";
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1749738215011</Id>
			<Name><![CDATA[DataResponseTriggerMessage]]></Name>
			<Text><![CDATA[/**
 * DataResponseTriggerMessage
 */	
public class DataResponseTriggerMessage extends firstprojectdraft.MessageType implements Serializable {

	
	public DataResponseTriggerMessage(Agent sender, double timestamp) {
		super(sender, timestamp);				
	}
	
	@Override
	public String toString() {
		return super.toString();
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1749805492008</Id>
			<Name><![CDATA[DataMessageFromPV]]></Name>
			<Text><![CDATA[/**
 * DataMessageFromPV
 */	
public class DataMessageFromPV extends firstprojectdraft.MessageType implements Serializable 
{

	double productionInThisStep;

    /**
     * Constructor initializing the fields
     */
    public DataMessageFromPV(Agent sender, double timestamp, double productionInThisStep) 
    {
    	super(sender, timestamp);
		this.productionInThisStep = productionInThisStep;
    }
    
    public DataMessageFromPV(Agent sender, double productionInThisStep) 
    {
    	super(sender, sender.time());
		this.productionInThisStep = productionInThisStep;
    }

	@Override
	public String toString() 
	{
		return  
			super.toString() + 	
			"productionInThisStep = " + productionInThisStep +" ";
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;
}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
