		<JavaClass>
			<Id>1749486892298</Id>
			<Name><![CDATA[MyTestClass]]></Name>
			<Text><![CDATA[/**
 * MyTestClass
 */	
public class MyTestClass implements Serializable {

	public int myTestInt = 1337;

    /**
     * Default constructor
     */
    public MyTestClass() {
    }

    /**
     * Constructor initializing the fields
     */
    public MyTestClass(int myTestInt) {
		this.myTestInt = myTestInt;
    }

	@Override
	public String toString() {
		return  
			"myTestInt = " + myTestInt +" ";
	}
	
	public void testFct1(Agent agent) {
		DataMessageFromPV myPvMessage = new DataMessageFromPV(agent, agent.time(), myTestInt); 
		
		System.out.println(myPvMessage);
	}

	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}]]></Text>
		</JavaClass>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1749487208744</Id>
			<Name><![CDATA[HouseControllerJava]]></Name>
			<Text><![CDATA[/**
 * HouseControllerHandler
 */	
public class HouseControllerJava implements Serializable {

	public HouseController owner;
	private double productionInThisTickPV;
	private double consumptionInThisTickPC;
	//private double powerBalanceInThisTick;
	private double differenceInThisTick;
	private int messageCounter = 0;
	private int numMessagesPerTick = 2;
	private double powerBalanceInThisTick;
	
    /**
     * Constructor
     */
    public HouseControllerJava(HouseController owner) {
    	this.owner = owner;
    }

	@Override
	public String toString() {
		return super.toString();
	}
	
	public boolean sendMessagesToAll() {
		
		owner.port.send(new DataResponseTriggerMessage(owner, owner.time())); 
		// should only trigger the sending of the data, so it doesnt be a specific message
		return true;
	}	
	
	public void messageIn(MessageType msg) {
		//System.out.println("msg in HouseController: " + msg);
		messageCounter++;

		if (msg instanceof DataMessageFromPV){

			double data = ((DataMessageFromPV) msg).productionInThisTick;
			owner.energy_saved += data;
			owner.energy_saved_stat.add(data);
			
			this.productionInThisTickPV = ((DataMessageFromPV) msg).productionInThisTick;
			//this.powerBalanceInThisTick = this.productionInThisTickPV - this.consumptionInThisTickPC;
			
			//System.out.println("THIS WAS PV");
		}
		else if (msg instanceof DataMessageFromPC){
			
			double data = ((DataMessageFromPC) msg).consumptionInThisTick;
			owner.energy_saved += data;
			owner.energy_saved_stat.add(data);
			
			this.consumptionInThisTickPC = ((DataMessageFromPC) msg).consumptionInThisTick;
			//this.powerBalanceInThisTick = this.productionInThisTickPV - this.consumptionInThisTickPC;
			
			//System.out.println("THIS WAS PC");			
		}
		else if (msg instanceof DataMessageFromBattery){
			
			differenceInThisTick = ((DataMessageFromBattery) msg).difference;
		}
		else{
		 	System.out.println("ERROR IN \"messageIn\". ");
		}
		
		
		if (messageCounter < numMessagesPerTick) {
			// still have to get messages from first ones (now PC, PV)
		}
		else if (messageCounter == numMessagesPerTick)
		{
			powerBalanceInThisTick = productionInThisTickPV - consumptionInThisTickPC;		
			
			owner.port.send(new DataMessageToBattery(owner, owner.time(), powerBalanceInThisTick));
		}
		else {
			simpleStrat();
			messageCounter = 0;
		}
		
		
	}	
	
	public void simpleStrat() {
		// what strat does: 
		// 1) determine what to do
		// 2) buy / sell energy
		// 3) send orders to battery
		
		
		//System.out.println(differenceInThisTick);
		//System.out.println(powerBalanceInThisTick);
		
		
		if(powerBalanceInThisTick > 0) {
			owner.energy += differenceInThisTick;
		}else {
			owner.energy -= differenceInThisTick;
		}		
		
		
		// System.out.println("maxCap in battery Agent: " + owner.get_Main().battery.maxCapInAgent);
		// System.out.println("maxCapInHandler in batteryHandler: " + owner.get_Main().battery.handler.maxCapInHandler);				
	}
	
	
	public void tstFct1() {
		System.out.println("Do I have access to a parameter in Main from HouseController? => yes");
		System.out.println("root.parentParameter: " + ((Main)owner.getOwner()).parentParameter);
		
		List<?> items = owner.getConnections();		
		items.forEach(item -> System.out.println(item));
		// => does nothing
	}
	
	/**
	 * This number is here for model snapshot storing purpose<br>
	 * It needs to be changed when this class gets changed
	 */ 
	private static final long serialVersionUID = 1L;

}
]]></Text>
